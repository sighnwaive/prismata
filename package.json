    "check:mobile-android-debug-signing": "sh scripts/check-mobile-android-debug-signing.sh",
    "check:mobile-android-cleartext-manifest": "node scripts/check-mobile-android-cleartext-manifest.mjs",
    "check:mobile-android-autolinking": "node scripts/check-mobile-android-autolinking.mjs",
    "check:mobile-android-native-discovery": "node scripts/check-mobile-android-native-discovery.mjs",
    "check:mobile-deep-link-config": "node scripts/check-mobile-deep-link-config.mjs",
    "check:mobile-metro": "sh scripts/check-mobile-metro.sh",
    "check:core-app-kit": "sh scripts/check-core-app-kit.sh",
    "check:desktop-electron-red": "sh scripts/check-desktop-electron-red.sh",
    "check:dotenvx-dev-red": "sh scripts/check-dotenvx-dev-red.sh",
    "check:backend-legacy-rls-red": "sh scripts/check-backend-legacy-rls-red.sh",
