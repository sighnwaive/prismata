    "check:backend-sync-clients": "sh scripts/check-backend-sync-clients.sh",
    "check:shared-ui-storybook": "sh scripts/check-shared-ui-storybook.sh",
    "check:workspaces": "pnpm --recursive list --depth -1",
    "dev:db:start": "docker compose -f docker-compose.local-postgres.yml up -d",
    "dev:db:stop": "docker compose -f docker-compose.local-postgres.yml down",
    "dev:up": "docker compose up -d --build",
    "dev:down": "docker compose down",
    "db:migrate": "pnpm --dir apps/backend run migrate",
    "storybook:web": "pnpm --filter @prismata/storybook storybook",
    "storybook:web:build": "pnpm --filter @prismata/storybook build-storybook",
    "storybook:mobile": "pnpm --filter @prismata/mobile storybook",
    "web:dev": "pnpm --filter @prismata/web dev",
    "web:build": "pnpm --filter @prismata/web build"
