{
  "name": "prismata",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@storybook/react": "^8.3.5",
    "@types/node": "^24.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check:backend-doc-naming-red": "sh scripts/check-backend-doc-naming-red.sh",
    "check:backend-fetch-red": "sh scripts/check-backend-fetch-red.sh",
    "check:backend-postgres-schema-red": "sh scripts/check-backend-postgres-schema-red.sh",
    "check:backend-sync-contract-red": "sh scripts/check-backend-sync-contract-red.sh",
    "check:backend-sync-client-red": "sh scripts/check-backend-sync-client-red.sh",
    "check:dev-postgres-red": "sh scripts/check-dev-postgres-red.sh",
    "check:deployment-contract": "sh scripts/check-deployment-contract.sh",
    "check:auth-sync-red": "sh scripts/check-auth-sync-red.sh",
    "check:backend-joystick-auth-callback-red": "sh scripts/check-backend-joystick-auth-callback-red.sh",
    "check:backend-joystick-auth-start-red": "sh scripts/check-backend-joystick-auth-start-red.sh",
    "check:backend-sync": "sh scripts/check-backend-sync.sh",
